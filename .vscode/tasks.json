{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BPGezinswetenschappen.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/BPGezinswetenschappen.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Api/API.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "npm: start",
      "type": "npm",
      "script": "start",
      "path": "Client",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(.*?)"
          },
          "endsPattern": {
            "regexp": "bundle generation complete"
          }
        }
      }
    },
    {
      "label": "start-api",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "Api/API.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "start-full-stack",
      "dependsOn": ["start-api", "npm: start"],
      "problemMatcher": []
    }
  ]
}
